# Production config for docker-compose.yml.
# Copy to .env on the VPS and fill in every value. .env is gitignored — never commit it.
#
# Generate secrets with:  openssl rand -hex 32
# (hex keeps them URL-safe, which matters for MONGODB_URL and the Redis URL)

# ── Public URLs ─────────────────────────────────────────────
FRONTEND_URL=https://stock.codingstack.site
SOCKET_CORS_ORIGIN=https://stock.codingstack.site

# Baked into the frontend bundle at build time — rebuild after changing
VITE_API_URL=https://apistock.codingstack.site/api
VITE_SOCKET_URL=https://apistock.codingstack.site

# ── MongoDB (shared instance on the `shared_db` network) ────
# User/password must match the app user created in the shared Mongo (see README).
MONGODB_URL=mongodb://inventory_app:CHANGE_ME@mongodb:27017/inventory?authSource=inventory&replicaSet=rs0

# ── Redis + Meilisearch (run inside this stack) ─────────────
# Their URLs are wired up in docker-compose.yml; only the secrets live here.
REDIS_PASSWORD=CHANGE_ME
MEILISEARCH_KEY=CHANGE_ME_AT_LEAST_16_CHARS

# ── Auth ────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30

# ── Email (Resend) — optional ───────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@codingstack.site
