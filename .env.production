# .env.production.example
# Copy to .env.production and fill in real values.

# Application
NODE_ENV=production
PORT=3000
DEPLOYMENT_MODE=saas
APP_VERSION=latest
GHCR_NAMESPACE=ghost-67-g

# Shared VPS-safe ingress
# Keep this stack off public 80/443 by default so existing VPS projects are not disturbed.
NGINX_BIND_IP=127.0.0.1
NGINX_HTTP_PORT=18080
NGINX_CONFIG=nginx.vps.conf

# MongoDB
MONGODB_URL=mongodb://inventory_app:admin123@mongodb:27017/inventory?authSource=inventory
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_APP_USERNAME=inventory_app
MONGO_APP_PASSWORD=admin123

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=b817ba7470d9dee4db944379cc2b2ea72c3040619e5b3bf4bc0e058e8b06334464cc98aeeb5181fc6154f313c28124b48cbb9e69b4b54085cb8f1473523449c6
JWT_REFRESH_SECRET=4a6ee42658ec7addc68bb67ddc07500c9b8fcb71698fee68857ebf6d553cc3ba34f297ad90be7bdda0f8946811437397ec80ce395489ac1b9b77b5e7f0528b39
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30

# Redis
REDIS_URL=redis://:redis121@redis:6379
REDIS_PASSWORD=redis121

# MeiliSearch
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_KEY=meili_master_key_change_me_1234

# Email (Resend)
RESEND_API_KEY=re_FRMxQDdv_H7f4rd7DCyAqzbBghG6uKDyE
EMAIL_FROM=noreply@devsdesk.site

# Frontend
FRONTEND_URL=https://stock.devsdesk.site

# Socket.io
SOCKET_CORS_ORIGIN=https://stock.devsdesk.site

# API (used by frontend build)
VITE_API_URL=https://apistock.devsdesk.site
VITE_SOCKET_URL=https://apistock.devsdesk.site
