{
  "name": "inventory-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "env-cmd -f .env.development ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "seed": "ts-node --project tsconfig.json scripts/seed.ts",
    "seed:fresh": "ts-node --project tsconfig.json scripts/seed.ts --fresh",
    "validate-seed": "ts-node --project tsconfig.json scripts/validate-seed.ts"
  },
  "dependencies": {
    "@types/luxon": "^3.7.1",
    "@types/multer": "^2.1.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.12",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.4.5",
    "env-cmd": "^11.0.0",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "meilisearch": "^0.46.0",
    "mongoose": "^8.6.2",
    "multer": "^2.1.1",
    "resend": "^6.9.4",
    "socket.io": "^4.8.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.2",
    "xss-clean": "^0.1.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.7.4",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.58.0"
  }
