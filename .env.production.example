# .env.production.example
# Copy to .env.production and fill in real values.

# Application
NODE_ENV=production
PORT=3000
DEPLOYMENT_MODE=saas
APP_VERSION=latest
GHCR_NAMESPACE=your-github-org

# Shared VPS-safe ingress
# Keep this stack off public 80/443 by default so existing VPS projects are not disturbed.
NGINX_BIND_IP=127.0.0.1
NGINX_HTTP_PORT=18080
NGINX_CONFIG=nginx.vps.conf

# MongoDB
MONGODB_URL=mongodb://inventory_app:CHANGE_ME_APP_PASSWORD@mongodb:27017/inventory?authSource=inventory
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MONGO_APP_USERNAME=inventory_app
MONGO_APP_PASSWORD=CHANGE_ME_APP_PASSWORD

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=GENERATE_64_BYTE_HEX_SECRET
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_64_BYTE_HEX_SECRET
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30

# Redis
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# MeiliSearch
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_KEY=CHANGE_ME_AT_LEAST_16_CHARS

# Email (Resend)
RESEND_API_KEY=re_XXXXXXXXXXXX
EMAIL_FROM=noreply@your-domain.com

# Frontend
FRONTEND_URL=https://your-domain.com

# Socket.io
SOCKET_CORS_ORIGIN=https://your-domain.com
