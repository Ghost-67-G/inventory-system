# .env.selfhosted.example
# Rename to .env and fill in your values.

# Server
HOST_PORT=80
APP_VERSION=latest
GHCR_NAMESPACE=your-github-org

# Database
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
MONGO_APP_USERNAME=inventory_app
MONGO_APP_PASSWORD=CHANGE_THIS_ALSO

# App database URL
MONGODB_URL=mongodb://inventory_app:CHANGE_THIS_ALSO@mongodb:27017/inventory?authSource=inventory

# App runtime
NODE_ENV=production
PORT=3000
DEPLOYMENT_MODE=self_hosted

# Redis
REDIS_PASSWORD=CHANGE_THIS_TOO
REDIS_URL=redis://:CHANGE_THIS_TOO@redis:6379

# Security keys
JWT_ACCESS_SECRET=GENERATE_ME
JWT_REFRESH_SECRET=GENERATE_ME_DIFFERENT
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30

# Email
RESEND_API_KEY=
EMAIL_FROM=

# URLs
FRONTEND_URL=http://localhost
SOCKET_CORS_ORIGIN=http://localhost

# MeiliSearch optional
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_KEY=changeme
